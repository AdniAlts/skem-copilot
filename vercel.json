{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm ci && npm run build -w @skem/web",
  "outputDirectory": "apps/web/dist",
  "functions": {
    "api/[...path].ts": {
      "maxDuration": 60
    },
    "api/cron/worker.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/worker",
      "schedule": "* * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
