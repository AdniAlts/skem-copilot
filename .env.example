# Salin ke .env lalu isi nilainya. JANGAN commit .env.
# Kunci dibagikan lewat kanal privat tim, bukan lewat repo atau issue.

# --- API server ---
PORT=3000
# String acak panjang untuk menandatangani cookie sesi mock login
SESSION_SECRET=

# --- LLM gateway CBN (OpenAI-compatible) ---
LLM_BASE_URL=https://litellm-hackathon.digdaya.ai/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4.1-flash

# --- Supabase (hanya dipakai backend) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string (Supabase > Project Settings > Database)
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:5432/postgres

# Bucket Storage (semua privat)
STORAGE_BUCKET_CERTIFICATES=certificates
STORAGE_BUCKET_SIGNATURES=signatures
STORAGE_BUCKET_FORMS=final-forms

# --- Telegram (Should have; kosongkan untuk menonaktifkan bot) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# --- Frontend (Vite; hanya nilai publik, tanpa rahasia) ---
VITE_API_BASE_URL=/api
